<!-- Sidebar -->
<div class="nav">
  <div class="logo">
    <a href="/"><h1>DevOps Bookmarks</h1></a>
  </div>

  <!-- Search -->
  <div class="search menu">
    <input type="search" id="tool-search" class="search-input" placeholder="Search tools&hellip;" aria-label="Search tools" autocomplete="off">
    <div id="search-results" class="search-results" hidden></div>
  </div>

  <!-- Topics menu -->
  <details class="topics menu" open>
    <summary>Topics <i class="fa fa-fw fa-chevron-down chevron"></i></summary>
    <% _u.each(topics, function(tag) { %>
      <div class="tag">
        <% var active = _u.contains(tags, tag.slug); %>
        <a class="toggle" href="<%= extraUrlFor(tag.slug, tags) %>">
          <i class="fa fa-fw <%= active ? 'fa-check-circle' : 'fa-circle-o' %>"></i>
        </a>
        <a class="<%= active ? 'active' : '' %>" href="<%= onlyUrlFor(tag.slug, topics, tags) %>">
          <%= tag.name %>
        </a>
      </div>
    <% }); %>
  </details>

  <!-- Platforms menu -->
  <details class="platforms menu" open>
    <summary>Platform <i class="fa fa-fw fa-chevron-down chevron"></i></summary>
    <% _u.each(platforms, function(tag) { %>
      <div class="tag">
        <% var active = _u.contains(tags, tag.slug); %>
        <a class="toggle" href="<%= extraUrlFor(tag.slug, tags) %>">
          <i class="fa fa-fw <%= active ? 'fa-check-circle' : 'fa-circle-o' %>"></i>
        </a>
        <a class="<%= active ? 'active' : '' %>" href="<%= onlyUrlFor(tag.slug, platforms, tags) %>">
          <i class="<%= tag.icon %>"></i>
          <%= tag.name %>
        </a>
      </div>
    <% }); %>
  </details>

  <!-- Licenses menu -->
  <details class="licenses menu" open>
    <summary>License <i class="fa fa-fw fa-chevron-down chevron"></i></summary>
    <% _u.each(licenses, function(tag) { %>
      <div class="tag">
        <% var active = _u.contains(tags, tag.slug); %>
        <a class="toggle" href="<%= extraUrlFor(tag.slug, tags) %>">
          <i class="fa fa-fw <%= active ? 'fa-check-circle' : 'fa-circle-o' %>"></i>
        </a>
        <a class="<%= active ? 'active' : '' %>" href="<%= onlyUrlFor(tag.slug, licenses, tags) %>">
          <i class="<%= tag.icon %>"></i>
          <%= tag.name %>
        </a>
      </div>
    <% }); %>
  </details>

  <!-- Languages menu -->
  <details class="languages menu" open>
    <summary>Language <i class="fa fa-fw fa-chevron-down chevron"></i></summary>
    <% _u.each(languages, function(tag) { %>
      <div class="tag">
        <% var active = _u.contains(tags, tag.slug); %>
        <a class="toggle" href="<%= extraUrlFor(tag.slug, tags) %>">
          <i class="fa fa-fw <%= active ? 'fa-check-circle' : 'fa-circle-o' %>"></i>
        </a>
        <a class="<%= active ? 'active' : '' %>" href="<%= onlyUrlFor(tag.slug, languages, tags) %>">
          <i class="<%= tag.icon %>"></i>
          <%= tag.name %>
        </a>
      </div>
    <% }); %>
  </details>

  <div class="meta menu">
    <h3>Meta</h3>
    <a href="https://github.com/zigsphere/devopsbookmarks.org/blob/master/CONTRIBUTING.md">Submit a tool</a>
    <a href="https://github.com/zigsphere/devopsbookmarks.org/blob/master/README.md">About</a>
    <a href="https://www.dsicommunity.org">DevOps Discord</a>
  </div>
</div>

<script>
  (function() {
    if (window.matchMedia && window.matchMedia('(max-width: 639px)').matches) {
      document.querySelectorAll('.nav details[open]').forEach(function(el) {
        el.removeAttribute('open');
      });
    }
  })();
</script>
